# ── 규정 제·개정 에이전트 환경변수 ──────────────────────────────────────────
# 모두 선택 사항입니다. 비워 두면 해당 기능만 꺼지고 나머지는 동작합니다.

# 법제처 Open API 사용자 ID — 「상위법 위임 조항」에서 법령 조문을 불러올 때 사용
LAW_OC=your_law_oc_key

# ── AI(조문 초안·수정안) ────────────────────────────────────────────────────
# 사용자가 화면의 [✦ AI 설정]에 키를 넣으면 그 키를 우선 사용합니다.
# 서버 공용 키를 두려면 아래를 설정하세요(공급자: gemini | claude | gpt).
SCENARIO_AI_PROVIDER=gemini
SCENARIO_AI_MODEL=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
# Gemini 모델 고정/선호 버전(비우면 계정에서 쓸 수 있는 최신 모델 자동 선택)
GEMINI_MODEL=
GEMINI_MODEL_PREF=

# 유사 규정 의미 검색 최소 유사도(regulations_vectors.* 색인 + Gemini 키 필요)
SEMANTIC_MIN_SCORE=0.55

# ── 로컬 LLM(Ollama, 선택) — 관리자가 승인한 서버 주소만 사용(SSRF 방지) ────────
OLLAMA_BASE_URL=
OLLAMA_ALLOWED_HOSTS=

# ── 기관 프로필·내규 데이터(다른 기관에서 쓸 때) ──────────────────────────
# 비우면 저장소의 org_config.json · regulations/ · regulations_manifest.json · regulations_vectors.* 사용
ORG_CONFIG=
REG_DIR=
REG_MANIFEST=
REG_VECTORS=

# ── 보안·운영 ────────────────────────────────────────────────────────────────
# CORS 허용 출처(쉼표 구분). 비우면 이 서비스의 vercel.app 도메인과 localhost만 허용
ALLOWED_ORIGINS=
PORT=5100
